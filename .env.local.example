# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API). Do not commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lead Finder (server-only, never NEXT_PUBLIC_). From Google Cloud:
# Places API (New) for searches and place details; PageSpeed Insights API for
# the audit's speed check.
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
